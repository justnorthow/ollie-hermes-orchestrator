#!/usr/bin/env bash
# Records argv to $FAKE_HERMES_LOG; writes expected files when applicable.
echo "$@" >> "${FAKE_HERMES_LOG:-/tmp/fake-hermes.log}"

case "$1 $2" in
  "profile create")
    mkdir -p "${HERMES_PROFILES_DIR}/$3"
    : > "${HERMES_PROFILES_DIR}/$3/.env"
    # Install per-profile shim if FAKE_TEST_BINDIR is set
    if [ -n "${FAKE_TEST_BINDIR}" ]; then
      cat > "${FAKE_TEST_BINDIR}/$3" <<'SHIM'
#!/usr/bin/env bash
echo "$@" >> "${FAKE_HERMES_LOG:-/tmp/fake-hermes.log}"
exit 0
SHIM
      chmod +x "${FAKE_TEST_BINDIR}/$3"
    fi
    ;;
  "profile delete")
    rm -rf "${HERMES_PROFILES_DIR:?}/$3"
    ;;
  "config get")
    # Mock the DEFAULT profile's model.* values so `inherit_model_config`
    # has something to read. Tests can override via FAKE_DEFAULT_<key> env.
    case "$3" in
      "model.default")  echo "${FAKE_DEFAULT_MODEL:-gpt-5.5}" ;;
      "model.provider") echo "${FAKE_DEFAULT_PROVIDER:-openai-codex}" ;;
      "model.base_url") echo "${FAKE_DEFAULT_BASE_URL:-https://chatgpt.com/backend-api/codex}" ;;
    esac
    ;;
esac
exit 0
