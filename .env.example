# Required: bearer token for orchestrator API. Generate with `openssl rand -hex 32`.
ORCHESTRATOR_KEY=

# Core Supabase service-role key — used by GET /v1/profile to read profiles via RPC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides — sensible defaults if unset:
# HERMES_STACK_DIR=/home/ubuntu/hermes-stack
# HERMES_PROFILES_DIR=/home/ubuntu/.hermes/profiles
# SYSTEMD_USER_DIR=/home/ubuntu/.config/systemd/user

# Optional — agent-to-agent dispatch. Defaults to off; only "direct" is
# implemented (local/linear are reserved names). This value is INSTANCE-WIDE:
# it gates consults for every profile on this box at once. Each profile ALSO
# needs its own DISPATCH_MODE (which controls whether that agent is offered the
# tools at all) plus DISPATCH_AGENT_ID, ORCHESTRATOR_URL and ORCHESTRATOR_KEY
# in its own environment. Setting only one side gives you tools that always
# refuse. See docs/runbooks/agent-dispatch.md.
# Requires a non-blank HERMES_GATEWAY_KEY (scripts/install.sh writes it blank
# for you to paste into), or every consult refuses with "misconfigured".
# DISPATCH_MODE=direct

# Optional — model catalog freshness check (python -m src.catalog_check).
# The file sink (docs/model-catalog/latest.md) always runs regardless of
# these. Set both to also open a Linear issue on a blocking finding (an
# unknown catalog id); leave both unset to skip that sink entirely.
# See docs/runbooks/model-catalog-check.md.
# LINEAR_API_KEY=
# LINEAR_TEAM_ID=
