# Required: bearer token for orchestrator API. Generate with `openssl rand -hex 32`.
ORCHESTRATOR_KEY=

# Core Supabase service-role key — used by GET /v1/profile to read profiles via RPC.
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides — sensible defaults if unset:
# HERMES_STACK_DIR=/home/ubuntu/hermes-stack
# HERMES_PROFILES_DIR=/home/ubuntu/.hermes/profiles
# SYSTEMD_USER_DIR=/home/ubuntu/.config/systemd/user
